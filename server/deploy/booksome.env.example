BOOKSOME_DB_URL=jdbc:mariadb://127.0.0.1:3306/booksome
BOOKSOME_DB_USERNAME=booksome_app
BOOKSOME_DB_PASSWORD=replace-with-app-password
BOOKSOME_DB_MIGRATOR_USERNAME=booksome_migrator
BOOKSOME_DB_MIGRATOR_PASSWORD=replace-with-migrator-password
BOOKSOME_DB_MAX_POOL_SIZE=10
BOOKSOME_DB_MIN_IDLE=2
BOOKSOME_SERVER_ADDRESS=127.0.0.1
BOOKSOME_SERVER_PORT=8080
BOOKSOME_CORS_ALLOWED_ORIGINS=https://booksome.top,https://www.booksome.top
BOOKSOME_JWT_SECRET=replace-with-base64-encoded-64-byte-secret
BOOKSOME_JWT_ISSUER=https://api.booksome.top
BOOKSOME_JWT_AUDIENCE=booksome-app
BOOKSOME_ACCESS_TOKEN_TTL=PT15M
BOOKSOME_REFRESH_TOKEN_TTL=P30D
BOOKSOME_MEDIA_ROOT=/service/booksome/data/media
BOOKSOME_MEDIA_PUBLIC_BASE_URL=https://api.booksome.top
